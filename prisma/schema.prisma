// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ServiceName {
  PAYMENTS_SERVICE
  AUTH_SERVICE
  ORDER_SERVICE
  NOTIFICATION_SERVICE
  DATABASE
  REDIS_CACHE
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  DIAGNOSING
  PENDING_APPROVAL
  RESOLVED
  FALSE_POSITIVE
}

enum AgentType {
  ORCHESTRATOR
  LOG_ANALYZER
  DIAGNOSIS
  ACTION
  COMMUNICATOR
}

model Deployment {
  id            String      @id @default(cuid())
  service       ServiceName
  commitHash    String
  commitMessage String
  deployedBy    String
  deployedAt    DateTime    @default(now())

  incidents Incident[]

  @@index([service, deployedAt])
}

model Incident {
  id       String           @id @default(cuid())
  title    String
  rawLog   String           @db.Text
  service  ServiceName
  severity IncidentSeverity @default(LOW)
  status   IncidentStatus   @default(OPEN)

  suspectedDeploymentId String?
  suspectedDeployment   Deployment? @relation(fields: [suspectedDeploymentId], references: [id])

  // ground truth for the eval harness later - agents never read these
  expectedDiagnosis     String
  expectedAction        String
  expectedRequiresHuman Boolean @default(false)
  scenarioType          String

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  actions AgentAction[]

  @@index([status, severity])
  @@index([createdAt])
}

model AgentAction {
  id         String    @id @default(cuid())
  incidentId String
  incident   Incident  @relation(fields: [incidentId], references: [id])
  agentType  AgentType
  input      Json
  output     Json
  reasoning  String?   @db.Text
  confidence Float?
  createdAt  DateTime  @default(now())

  @@index([incidentId, createdAt])
}

model FeatureFlag {
  id        String      @id @default(cuid())
  key       String      @unique
  service   ServiceName
  enabled   Boolean     @default(true)
  updatedAt DateTime    @updatedAt
  updatedBy String      @default("system")
}